# ============================================================================
# Blasa API — production environment (Render)
#
# These are the ONLY variables the app reads in production. Every one is
# declared in render.yaml; the ones marked "sync: false" are prompted for in
# the Render dashboard and must be pasted there.
#
# Placeholders in <ANGLE_BRACKETS> are the only values you have to supply.
# ============================================================================

# --- Django core -------------------------------------------------------------
# manage.py / asgi.py / celery.py all default to config.settings.dev. Without
# this line the container boots with DEBUG=True.
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_DEBUG=0
# Render generates this (generateValue: true). 50+ random chars.
DJANGO_SECRET_KEY=<generated-by-render>
# prod.py raises RuntimeError at import if this is empty. Must contain the exact
# Render hostname; add a custom domain here too if you attach one.
DJANGO_ALLOWED_HOSTS=blasa-api.onrender.com

# --- Neon Postgres (PostGIS) -------------------------------------------------
# 1. Create the project, then in the SQL editor run:
#        CREATE EXTENSION IF NOT EXISTS postgis;
# 2. Use the DIRECT host (no "-pooler") — this app opens very few connections,
#    and the direct endpoint avoids PgBouncer's prepared-statement quirks during
#    the `migrate` that runs at container boot.
# 3. ?sslmode=require is mandatory; Neon refuses plaintext connections.
# django-environ moves sslmode into OPTIONS and base.py forces the PostGIS engine.
DATABASE_URL=postgresql://neondb_owner:<NEON_PASSWORD>@ep-<endpoint-id>.<region>.aws.neon.tech/neondb?sslmode=require

# If you prefer the pooled endpoint (adds "-pooler" to the host), append
# &channel_binding=require and use exactly:
#   postgresql://neondb_owner:<PASSWORD>@ep-<id>-pooler.<region>.aws.neon.tech/neondb?sslmode=require

# --- Upstash Redis (Channels layer + Celery broker + result backend) ---------
# Must be the TLS scheme. settings/base.py detects "rediss://" and passes
# ssl_cert_reqs=None to channels_redis, which Upstash's chain requires.
REDIS_URL=rediss://default:<UPSTASH_PASSWORD>@<endpoint>.upstash.io:6379

# --- Celery ------------------------------------------------------------------
# REQUIRED on free tier: there is no worker, so .delay() must run inline.
# Without it, send_otp_sms.delay() queues a message nobody consumes and login
# breaks silently.
CELERY_TASK_ALWAYS_EAGER=1
CELERY_SOCKET_TIMEOUT=10

# --- Cloudflare R2 (private identity-document bucket) ------------------------
# Bucket must stay private: these are CIN / carte grise scans.
S3_BUCKET_PRIVATE=blasa-private-docs
# https://<account-id>.r2.cloudflarestorage.com  (account id, not bucket name)
S3_ENDPOINT_URL=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2 and B2 both require "auto"; boto3 cannot sign a presigned URL without a region.
S3_REGION=auto
# From an R2 API token with Object Read & Write on that bucket.
AWS_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
# Leave 0: documents already use presigned boto3 URLs directly, this only
# affects Django FileFields (none today).
USE_S3_STORAGE=0

# --- Brevo (transactional email + SMS over HTTPS) ----------------------------
# Render free blocks outbound SMTP, so this key switches EMAIL_BACKEND to
# core.delivery.brevo.BrevoEmailBackend and SMS_PROVIDER to "brevo" automatically.
BREVO_API_KEY=xkeysib-<YOUR_BREVO_API_KEY>
# Alphanumeric sender for SMS. Must be pre-approved in the Brevo dashboard.
BREVO_SMS_SENDER=Blasa
# The address MUST be a verified sender/domain in Brevo, otherwise every send
# returns 400 and is silently logged as "not sent". Format: Name <address>
DEFAULT_FROM_EMAIL=Blasa <no-reply@<YOUR_VERIFIED_DOMAIN>>

# --- Flouci payments (optional — leave blank if not testing payments) --------
# The webhook URL to register in Flouci is
#   https://blasa-api.onrender.com/api/v1/payments/webhooks/flouci/
FLOUCI_BASE_URL=https://pay.flouci.com
FLOUCI_APP_KEY=<FLOUCI_APP_KEY>
FLOUCI_PRIVATE_KEY=<FLOUCI_PRIVATE_KEY>
FLOUCI_PUBLIC_KEY=<FLOUCI_PUBLIC_KEY>
# Must NOT stay at the dev default, or real webhooks are rejected.
FLOUCI_WEBHOOK_SECRET=<RANDOM_32_CHARS>

# --- CORS --------------------------------------------------------------------
# Only matters for the web build (Vercel) and Swagger; native apps are
# unaffected. Comma-separated, no trailing slash, exact origin including scheme.
# Add both the production and preview Vercel domains if you use preview deploys.
CORS_ALLOWED_ORIGINS=https://<YOUR_APP>.vercel.app

# --- Identity document uploads (Law 2004-63 gate) ----------------------------
# Stays 0 in production until docs/legal/law-2004-63-compliance.md is signed off.
# With 0, POST /verification/documents/upload-url/ returns 403 and drivers
# cannot complete verification. Set to 1 only for a throwaway test environment.
IDENTITY_DOCUMENT_UPLOADS_ENABLED=0

# --- Sentry (optional) -------------------------------------------------------
# Empty string disables it entirely; no network call is attempted.
SENTRY_DSN=https://<KEY>@o<ORG_ID>.ingest.sentry.io/<PROJECT_ID>
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_RATE=0.05

# --- Optional feature flags --------------------------------------------------
EXPO_PUSH_ENABLED=0
NOTIFICATION_EMAIL_ENABLED=0
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30
