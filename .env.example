DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgis://blasa:blasa@db:5432/blasa
REDIS_URL=redis://redis:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# --- Free-tier stack (see docs/deploy-free-tier.md) ------------------------
# Neon: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Upstash: rediss://default:<password>@<host>:6379 (TLS is required)
# DATABASE_URL / REDIS_URL above are the local Docker defaults.

# Brevo: email + SMS over HTTPS (Render free blocks outbound SMTP).
# Leave empty locally; OTP delivery is then logged without the code.
BREVO_API_KEY=
BREVO_SMS_SENDER=Blasa
DEFAULT_FROM_EMAIL=Blasa <no-reply@blasa.tn>
# console = log-only stub, brevo = transactional SMS. Auto-selects brevo when
# BREVO_API_KEY is set.
SMS_PROVIDER=console

# Cloudflare R2 (private identity documents). S3_REGION=auto for R2/B2.
S3_BUCKET_PRIVATE=blasa-private-docs
S3_ENDPOINT_URL=
S3_REGION=auto
# Placeholder credentials so presigned URL generation works in dev without real S3.
# Replace with real values (or point S3_ENDPOINT_URL at MinIO) when uploading for real.
AWS_ACCESS_KEY_ID=dev-placeholder
AWS_SECRET_ACCESS_KEY=dev-placeholder

# Sentry error monitoring (free tier). Empty disables it entirely.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_RATE=0.05

FCM_CREDENTIALS_PATH=
