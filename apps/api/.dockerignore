# Keep the production build context small and free of secrets.
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.log

# Local secrets must never enter an image layer.
.env
.env.*

# Runtime artefacts; collectstatic recreates staticfiles inside the image.
staticfiles/
media/

# Tokens captured by the API smoke-test script.
generated/_tokens.json
